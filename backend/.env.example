# App
PORT=3000
NODE_ENV=development

# PostgreSQL — cài native trên máy (không Docker), điền đúng username/password
# bạn đã đặt lúc cài PostgreSQL + tên database bạn tạo (CREATE DATABASE vegetmealplan;)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=doi_thanh_password_ban_dat_luc_cai
DB_NAME=vegetmealplan
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=change_me_in_dot_env_local
JWT_EXPIRES_IN=1d

# Đăng nhập Google (OAuth2). Để trống thì app vẫn chạy, riêng /auth/google trả 503 AUTH_GOOGLE_NOT_CONFIGURED.
# Lấy ở https://console.cloud.google.com → APIs & Services → Credentials → Create Credentials → OAuth client ID
# (Application type: Web application). "Authorized redirect URIs" phải có ĐÚNG giá trị GOOGLE_CALLBACK_URL bên dưới.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Trang FE mà backend chuyển về sau khi đăng nhập Google (FE cần có /login và /auth/google/callback)
FRONTEND_URL=http://localhost:3001

# Usage quota (thay TRIAL_QUERY_LIMIT cũ)
GUEST_CHATBOT_LIMIT=2
FREE_CHATBOT_LIMIT=5

# Subscription (gói tháng, VNPay)
MONTHLY_PLAN_PRICE=99000
# TODO: các key VNPay thật (chưa có merchant thật nên chưa cần điền)
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_RETURN_URL=
