# App
PORT=3000
NODE_ENV=development

# PostgreSQL — cài native trên máy (không Docker), điền đúng username/password
# bạn đã đặt lúc cài PostgreSQL + tên database bạn tạo (CREATE DATABASE vegetmealplan;)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=doi_thanh_password_ban_dat_luc_cai
DB_NAME=vegetmealplan
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=change_me_in_dot_env_local
# Thời hạn access token. Khi FE đã tự gọi /auth/refresh lúc hết hạn thì nên rút xuống 15m.
JWT_EXPIRES_IN=1d
# Thời hạn refresh token (ngày). Mỗi lần refresh được gia hạn lại từ đầu.
JWT_REFRESH_EXPIRES_DAYS=30

# Đăng nhập Google (OAuth2). Để trống thì app vẫn chạy, riêng /auth/google trả 503 AUTH_GOOGLE_NOT_CONFIGURED.
# Lấy ở https://console.cloud.google.com → APIs & Services → Credentials → Create Credentials → OAuth client ID
# (Application type: Web application). "Authorized redirect URIs" phải có ĐÚNG giá trị GOOGLE_CALLBACK_URL bên dưới.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Trang FE mà backend chuyển về sau khi đăng nhập Google (FE cần có /login và /auth/google/callback)
# Địa chỉ FE: redirect sau khi đăng nhập Google + domain được phép gọi API (CORS). Nhiều domain: ngăn cách bằng dấu phẩy
FRONTEND_URL=http://localhost:3001

# Gửi email (OTP quên mật khẩu). Để trống MAIL_HOST thì mail không gửi mà in ra console (đủ để test local).
# Gmail: bật xác minh 2 bước rồi tạo App password tại https://myaccount.google.com/apppasswords
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM="VegetMealPlan <your_email@gmail.com>"

# Usage quota (thay TRIAL_QUERY_LIMIT cũ)
GUEST_CHATBOT_LIMIT=2
FREE_CHATBOT_LIMIT=5

# Subscription (gói tháng, VNPay)
MONTHLY_PLAN_PRICE=99000
# Khoá VNPay. Sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg (nhận qua email). Để trống thì /subscriptions/checkout trả 503.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Bản thật đổi thành https://pay.vnpayment.vn/vpcpay.html
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trang FE nhận người dùng sau khi thanh toán; để trống thì lấy FRONTEND_URL + /subscriptions/vnpay-return
VNPAY_RETURN_URL=http://localhost:3001/subscriptions/vnpay-return
# URL IPN KHÔNG đặt ở đây mà khai trên trang quản trị VNPay: <địa chỉ công khai>/api/v1/subscriptions/vnpay-ipn (local thì dùng ngrok)
